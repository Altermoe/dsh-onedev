# ---- dsh-onedev-mcp ----
# OneDev server base URL (trailing slash is stripped).
#
# NOTE: when running as a dsh bundle you do NOT need this env var — set the
# server URL, administrator username/password (or access token), and the extra
# pass-through options below from the dsh Web GUI (Settings → OneDev). The MCP
# server reads the credential store on every call, so GUI edits apply without a
# restart. Env vars below still win over the store when both are present.
# ONEDEV_URL=http://localhost:6610

# ---- Environment selection ----
# Pick a configured environment by slug when no `environment` tool argument is
# passed (defaults to the store's primary environment). Env vars below still win
# over the store for the PRIMARY environment only.
# ONEDEV_ENV=prod

# ---- Authentication ----
# Either a pre-created access token (Bearer)...
ONEDEV_TOKEN=your-access-token
# ...or an account + password, which OneDev authenticates automatically
# (HTTP Basic login) so no token has to be minted first. Pick one of the two
# modes below. To use the token mode leave ONEDEV_AUTH_TYPE unset or =token.
# ONEDEV_AUTH_TYPE=password
# ONEDEV_USERNAME=root
# ONEDEV_PASSWORD=your-password

# ---- optional ----
# REST base path appended to ONEDEV_URL (default /~api)
# ONEDEV_API_BASE=/~api
# Transport: stdio (default) or streamable-http
# ONEDEV_MCP_TRANSPORT=stdio
# Command override: "setup" launches the config console (a localhost GUI) instead
# ONEDEV_MCP_COMMAND=setup
# HTTP mode / setup-console bind host/port
# ONEDEV_MCP_HOST=127.0.0.1
# ONEDEV_MCP_PORT=8765
# Per-request timeout in ms (default 30000)
# ONEDEV_API_TIMEOUT_MS=30000
# true refuses every mutating request (read-only)
# ONEDEV_MCP_READONLY=false
# Extra JSON request headers merged over auth, e.g. {"X-Trace":"foo"}
# ONEDEV_MCP_HEADERS={}
# Credential-store path (default ~/.config/dsh-onedev/config.json)
# ONEDEV_CONFIG_FILE=/absolute/path/to/config.json

# ---- documentation query (onedev_docs_* tools) ----
# Base URL of the OneDev documentation site used by the docs-query tools.
# These tools are standalone: they need no OneDev connection/credentials.
# ONEDEV_DOCS_URL=https://docs.onedev.io